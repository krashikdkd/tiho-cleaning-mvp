{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "https://myagko-cleaning.vercel.app/" },
    { "source": "/index.html", "destination": "https://myagko-cleaning.vercel.app/" },
    { "source": "/admin.html", "destination": "https://myagko-cleaning.vercel.app/admin" },
    { "source": "/services.html", "destination": "https://myagko-cleaning.vercel.app/services" },
    { "source": "/contacts.html", "destination": "https://myagko-cleaning.vercel.app/contacts" },
    { "source": "/privacy.html", "destination": "https://myagko-cleaning.vercel.app/privacy" },
    { "source": "/credits.html", "destination": "https://myagko-cleaning.vercel.app/credits" },
    { "source": "/api/:path*", "destination": "https://myagko-cleaning.vercel.app/api/:path*" },
    { "source": "/request/:path*", "destination": "https://myagko-cleaning.vercel.app/request/:path*" },
    { "source": "/_next/:path*", "destination": "https://myagko-cleaning.vercel.app/_next/:path*" },
    { "source": "/next-assets/:path*", "destination": "https://myagko-cleaning.vercel.app/_next/:path*" },
    { "source": "/:path*", "destination": "https://myagko-cleaning.vercel.app/:path*" }
  ]
}
